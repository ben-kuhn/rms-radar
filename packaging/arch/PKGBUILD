# Maintainer: RMS Radar contributors

pkgname=rms-radar
pkgver=1.0.12
pkgrel=1
pkgdesc="Winlink RMS gateway map with service-code filtering and propagation ranking"
arch=('x86_64' 'aarch64' 'armv7h')
url="https://github.com/ben-kuhn/rms-radar"
license=('MIT')
depends=()
makedepends=('go')
optdepends=('voacapl: point-to-point HF propagation forecasts (requires the itshfbc data)')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('a54ebe99b75c20449c811547c31c3bc98998c9aa53d24b241d534bd0d5dadb50')

build() {
  cd "${pkgname}-${pkgver}"
  export CGO_ENABLED=0
  go build -trimpath -ldflags "-s -w -X main.version=${pkgver}" -o rms-radar .
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 rms-radar "${pkgdir}/usr/bin/rms-radar"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 packaging/common/rms-radar.service "${pkgdir}/usr/lib/systemd/system/rms-radar.service"
  install -Dm644 contrib/desktop/rms-radar.desktop "${pkgdir}/usr/share/applications/rms-radar.desktop"
  install -Dm644 contrib/desktop/rms-radar.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/rms-radar.svg"
  install -Dm644 contrib/desktop/rms-radar-1024.png "${pkgdir}/usr/share/icons/hicolor/1024x1024/apps/rms-radar.png"
  # The web UI is embedded in the binary; no separate assets to install.
}
